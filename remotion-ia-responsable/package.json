{
  "name": "ia-responsable-video",
  "version": "1.0.0",
  "description": "Video verticale documentaire \"IA Responsable\" (gouvernance, securite, Green IA) — Remotion",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "remotion studio",
    "studio": "remotion studio",
    "render": "remotion render VideoUn out/ia-responsable.mp4",
    "render:4k": "remotion render VideoUn out/ia-responsable-4k.mp4 --scale=2 --crf=16",
    "render:8k": "remotion render VideoUn out/ia-responsable-8k.mp4 --scale=4 --crf=14",
    "still": "remotion still VideoUn out/still.png --frame=120",
    "fetch-assets": "node scripts/fetch-assets.mjs",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/google-fonts": "^4.0.0",
    "@remotion/transitions": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.4.0"
  }
}
